FROM ghcr.io/cybozu/golang:1.26-noble AS builder
ARG GOPROXY
WORKDIR /work
COPY go.mod go.mod
COPY go.sum go.sum
# The netrc secret carries Takumi Guard credentials in CI; it is optional so that local builds still work.
RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    GOPROXY=${GOPROXY} go mod download

COPY cmd/necoperf-cli cmd/necoperf-cli
COPY internal internal
# GOPROXY=off: every module is already in the local cache from `go mod download` above.
RUN CGO_ENABLED=0 GOPROXY=off go build -ldflags="-w -s" -o necoperf-cli ./cmd/necoperf-cli

FROM ghcr.io/cybozu/ubuntu:24.04
LABEL org.opencontainers.image.source=https://github.com/cybozu-go/necoperf
COPY --from=builder /work/necoperf-cli /usr/local/bin/necoperf-cli

USER 1000:1000
CMD ["pause"]
